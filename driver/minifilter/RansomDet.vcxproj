<?xml version="1.0" encoding="utf-8"?>
<!--
  RansomDet.vcxproj
  Visual Studio 2022 project for the RansomDet minifilter driver.

  Requirements:
    - Visual Studio 2022 Community (or higher)
    - Windows Driver Kit (WDK) for Windows 11
    - "Windows Driver Kit" VS extension (installed with WDK)

  Build:
    Open in VS2022 → select "Debug | x64" → Build Solution
    Output: x64\Debug\RansomDet.sys
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{A1B2C3D4-E5F6-7890-ABCD-EF1234567890}</ProjectGuid>
    <TemplateGuid>{A1B2C3D4-E5F6-7890-ABCD-EF1234567891}</TemplateGuid>
    <TargetFrameworkVersion>v4.5</TargetFrameworkVersion>
    <MinimumVisualStudioVersion>14.0</MinimumVisualStudioVersion>
    <Configuration>Debug</Configuration>
    <Platform>x64</Platform>
    <RootNamespace>RansomDet</RootNamespace>
    <WindowsTargetPlatformVersion>10.0.28000.0</WindowsTargetPlatformVersion>
    <WindowsDriverTargetOsVersion>10.0</WindowsDriverTargetOsVersion>
    <WDKContentRoot>$(Registry:HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows Kits\Installed Roots@KitsRoot10)</WDKContentRoot>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>Driver</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <DriverType>MiniFilter</DriverType>
    <DriverTargetPlatform>Universal</DriverTargetPlatform>
    <DebuggerFlavor>DbgengKernelDebugger</DebuggerFlavor>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>Driver</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <DriverType>MiniFilter</DriverType>
    <DriverTargetPlatform>Universal</DriverTargetPlatform>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <OutDir>$(SolutionDir)$(Configuration)\</OutDir>
    <IntDir>$(Configuration)\</IntDir>
    <TargetName>RansomDet</TargetName>
    <TargetExt>.sys</TargetExt>
    <EnableInf2cat>false</EnableInf2cat>
    <SignMode>TestSign</SignMode>
    <SignHashAlgorithm>SHA256</SignHashAlgorithm>
    <SignToolAdditionalOptions>/fd SHA256</SignToolAdditionalOptions>
  </PropertyGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
    <PreprocessorDefinitions>
     STD_CALL;DBG=1;%(PreprocessorDefinitions)
    </PreprocessorDefinitions>
    <BufferSecurityCheck>false</BufferSecurityCheck>
    <ControlFlowGuard>false</ControlFlowGuard>

      <AdditionalIncludeDirectories>
  C:\Program Files (x86)\Windows Kits\10\Include\10.0.28000.0\km;
  C:\Program Files (x86)\Windows Kits\10\Include\10.0.28000.0\shared;
  C:\Program Files (x86)\Windows Kits\10\Include\10.0.28000.0\um;
  %(AdditionalIncludeDirectories)
</AdditionalIncludeDirectories>
      <WarningLevel>Level4</WarningLevel>
      <WarnAsError>false</WarnAsError>
    </ClCompile>
    <Link>
  <AdditionalDependencies>fltmgr.lib;ntoskrnl.lib;%(AdditionalDependencies)</AdditionalDependencies>
  <EntryPointSymbol>DriverEntry</EntryPointSymbol>
</Link>
    <Inf>
      <SpecifyDriverVerDirectiveDate>false</SpecifyDriverVerDirectiveDate>
    </Inf>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="RansomDet.c" />
  </ItemGroup>

  <ItemGroup>
    <ClInclude Include="RansomDet.h" />
  </ItemGroup>

  <ItemGroup>
    <Inf Include="RansomDet.inf" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />

</Project>
